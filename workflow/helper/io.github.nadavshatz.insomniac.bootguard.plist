<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Insomniac boot guard.
  Runs once per boot as root and re-enables normal system sleep, so a crash,
  forced shutdown, or kernel panic during a closed-lid session can never leave
  the Mac permanently unable to sleep. It invokes /usr/bin/pmset directly:
  no scripts, nothing user-writable.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.nadavshatz.insomniac.bootguard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/pmset</string>
		<string>-a</string>
		<string>disablesleep</string>
		<string>0</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LaunchOnlyOnce</key>
	<true/>
</dict>
</plist>
